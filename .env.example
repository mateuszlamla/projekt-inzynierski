# Skopiuj do .env w katalogu głównym repozytorium i dostosuj.

# Model językowy do opisów AI w raporcie. Działa z każdym serwerem z API zgodnym z OpenAI.
# Domyślnie: Ollama uruchamiana przez `docker compose --profile ai up`.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=gemma3:4b
LLM_API_KEY=ollama

# Inne przykłady:
# Ollama zainstalowana w systemie (poza Dockerem):
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
# Bielik w PLGrid (jak w translatorze):
#   LLM_BASE_URL=https://llmlab.plgrid.pl/api/v1
#   LLM_MODEL=speakleash/Bielik-11B-v3.0-Instruct
#   LLM_API_KEY=<klucz>
